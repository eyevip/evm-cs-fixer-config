{
	"name": "eyevip/evm-cs-fixer-config",
	"description": "Shared PHP-CS-Fixer ruleset for eyevip PHP repositories",
	"type": "library",
	"license": "proprietary",
	"require": {
		"php": "^8.4",
		"friendsofphp/php-cs-fixer": "^3.95"
	},
	"autoload": {
		"psr-4": {
			"Eyevip\\CsFixerConfig\\": "src/"
		}
	},
	"scripts": {
		"format": "php-cs-fixer fix",
		"format:check": "php-cs-fixer fix --dry-run --diff"
	}
}
